# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos (Docker Compose)
POSTGRES_DB=alertaclima
POSTGRES_USER=alertaclima
POSTGRES_PASSWORD=cambia-esta-clave

# API
PORT=3000
# Orígenes que pueden llamar a la API, separados por coma
CORS_ORIGINS=http://localhost:5173

# Solo para correr el servidor fuera de Docker (npm run dev en server/)
DATABASE_URL=postgres://alertaclima:cambia-esta-clave@localhost:5432/alertaclima

# Fases siguientes (aún sin uso)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contacto@tu-dominio.cl
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
